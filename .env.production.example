# 数据库配置
MYSQL_ROOT_PASSWORD=change_this_password_in_production
MYSQL_DATABASE=badminton_analysis
MYSQL_USER=badminton_app
MYSQL_PASSWORD=change_this_password_in_production

# Spring Boot 后端配置
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/badminton_analysis?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=badminton_app
SPRING_DATASOURCE_PASSWORD=change_this_password_in_production

# 上传配置
UPLOAD_PATH=/app/uploads/videos
MAX_FILE_SIZE=500M

# Java JVM 优化
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
